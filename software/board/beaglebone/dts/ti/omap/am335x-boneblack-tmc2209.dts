// SPDX-License-Identifier: GPL-2.0-only
/*
 * BeagleBone Black + two BIGTREETECH TMC2209 stepper drivers
 *
 * Both drivers share one single-wire UART bus, told apart by their
 * MS1/MS2 address straps:
 *   P9_24  UART1_TXD  --[1k]--+-- PDN_UART of driver 1 and driver 2
 *   P9_26  UART1_RXD  --------+
 *
 *   Motor 1 (UART address 0, MS1=GND MS2=GND)
 *     P9_16  GPIO1_19   STEP
 *     P9_18  GPIO0_4    DIR
 *   Motor 2 (UART address 2, MS1=GND MS2=3.3V)
 *     P9_12  GPIO1_28   STEP
 *     P9_30  GPIO3_16   DIR
 *   Endstops (switch to GND, internal pull-up: 1 = open, 0 = pressed)
 *     P9_14  GPIO1_18   motor 1
 *     P9_22  GPIO0_2    motor 2
 *   Tip RGB LED (/sys/class/leds/tip-*; pulled down, off at boot)
 *     P8_12  GPIO1_12   red   (gpio-leds, on/off: P8_12 has no PWM)
 *     P8_13  EHRPWM2B   green (pwm-leds, brightness 0-255)
 *     P8_19  EHRPWM2A   blue  (pwm-leds, brightness 0-255)
 *   IR receiver (VS1838, powered from P9_3 3.3 V; /sys/class/rc/rc0)
 *     P8_16  GPIO1_14   OUT   (gpio-ir-recv, low while it sees 38 kHz),
 *                       with 10k to 3.3 V: the internal pull-up is too weak
 *
 * STEP 2 was on P9_28 but that pin stays at ~3.3 V even when driven low
 * (measured 2026-10-09, shield removed), so it moved to P9_12. HDMI audio
 * stays disabled so nothing else drives P9_28. HDMI video is unaffected.
 */
#include "am335x-boneblack.dts"

/ {
	model = "TI AM335x BeagleBone Black + 2x TMC2209";

	/* Held by the kernel so they stay on after "scara led" exits */
	leds-tip {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&tip_led_pins>;

		led-tip-red {
			label = "tip-red";
			gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* 10 kHz: no visible dotting in a long-exposure photo of a move */
	leds-tip-pwm {
		compatible = "pwm-leds";

		led-tip-green {
			label = "tip-green";
			pwms = <&ehrpwm2 1 100000 0>;	/* B: P8_13 */
			max-brightness = <255>;
			default-state = "off";
		};

		led-tip-blue {
			label = "tip-blue";
			pwms = <&ehrpwm2 0 100000 0>;	/* A: P8_19 */
			max-brightness = <255>;
			default-state = "off";
		};
	};

	/* Decoded by the kernel: scara ir reads the scancodes */
	ir-receiver {
		compatible = "gpio-ir-receiver";
		pinctrl-names = "default";
		pinctrl-0 = <&ir_pins>;
		gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
	};
};

&am33xx_pinmux {
	pinctrl-0 = <&clkout2_pin &tmc2209_gpio_pins &endstop_pins>;

	tmc2209_uart1_pins: tmc2209-uart1-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_UART1_RXD, PIN_INPUT_PULLUP, MUX_MODE0)	/* P9_26 */
			AM33XX_PADCONF(AM335X_PIN_UART1_TXD, PIN_OUTPUT_PULLUP, MUX_MODE0)	/* P9_24 */
		>;
	};

	/* Pulled down so STEP/DIR stay low while no program drives them */
	tmc2209_gpio_pins: tmc2209-gpio-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_GPMC_A3, PIN_OUTPUT_PULLDOWN, MUX_MODE7)	/* P9_16 STEP 1 */
			AM33XX_PADCONF(AM335X_PIN_SPI0_D1, PIN_OUTPUT_PULLDOWN, MUX_MODE7)	/* P9_18 DIR 1 */
			AM33XX_PADCONF(AM335X_PIN_MCASP0_AXR0, PIN_OUTPUT_PULLDOWN, MUX_MODE7)	/* P9_30 DIR 2 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_BEN1, PIN_OUTPUT_PULLDOWN, MUX_MODE7)	/* P9_12 STEP 2 */
		>;
	};

	/* Pulled down so the LED stays off until the driver takes the line */
	tip_led_pins: tip-led-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD12, PIN_OUTPUT_PULLDOWN, MUX_MODE7)	/* P8_12 tip LED red */
		>;
	};

	tip_pwm_pins: tip-pwm-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD9, PIN_OUTPUT_PULLDOWN, MUX_MODE4)	/* P8_13 ehrpwm2B green */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD8, PIN_OUTPUT_PULLDOWN, MUX_MODE4)	/* P8_19 ehrpwm2A blue */
		>;
	};

	/* The VS1838 output idles high; the pull-up keeps it there unplugged */
	ir_pins: ir-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD14, PIN_INPUT_PULLUP, MUX_MODE7)	/* P8_16 IR receiver */
		>;
	};

	/* Switch to GND: pull-up reads 1 when open, 0 when pressed */
	endstop_pins: endstop-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_GPMC_A2, PIN_INPUT_PULLUP, MUX_MODE7)	/* P9_14 endstop 1 */
			AM33XX_PADCONF(AM335X_PIN_SPI0_SCLK, PIN_INPUT_PULLUP, MUX_MODE7)	/* P9_22 endstop 2 */
		>;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&tmc2209_uart1_pins>;
	status = "okay";
};

/* PWM for the green and blue tip LED */
&epwmss2 {
	status = "okay";
};

&ehrpwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&tip_pwm_pins>;
	status = "okay";
};

/* HDMI audio off: keeps McASP0 off P9_28 (AHCLKR/AXR2), see above */
&mcasp0 {
	status = "disabled";
};

&{/sound} {
	status = "disabled";
};
